---
import { Icon } from "astro-icon/components";
import CollectionGrid from "@/components/pages/CollectionGrid.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import "@/styles/pages/common.css";

const title = "项目";
const description = "做过的自动化流程与工具，含背景、取舍和复盘";

const allPosts = await getSortedPosts();
const count = allPosts.filter(
	(entry) => entry.id === "projects/index" || entry.id.startsWith("projects/"),
).length;
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<header class="card-base page-header">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon name="material-symbols:rocket-launch" />
				</div>
				<div>
					<h2>{title}</h2>
					{description && <p>{description}</p>}
				</div>
			</div>
			<div class="page-count" aria-label={title}>
				<Icon name="material-symbols:rocket-launch" />
				<strong>{count}</strong>
				<span>{title}</span>
			</div>
		</header>

		<CollectionGrid
			section="projects"
			emptyHint="还没有项目记录，先从一个跑起来的小工具开始"
		/>
	</section>
</MainGridLayout>
