{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkBuddy design tokens v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "units",
    "source",
    "colors",
    "neutrals",
    "typography",
    "spacing",
    "radius",
    "elevation",
    "iconography"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "units": {
      "type": "object",
      "required": ["length", "size"],
      "properties": {
        "length": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "source": { "type": "string" },
    "source_kind": {
      "type": "string",
      "enum": ["observed", "derived", "user_specified"]
    },
    "colors": {
      "type": "object",
      "required": ["source", "values"],
      "properties": {
        "source": { "type": "string" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" }
        }
      }
    },
    "neutrals": {
      "type": "object",
      "required": ["source", "values"],
      "properties": {
        "source": { "type": "string" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" }
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["source", "scale"],
      "properties": {
        "source": { "type": "string" },
        "scale": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "size", "lineHeight", "weight"],
            "properties": {
              "name": { "type": "string" },
              "size": { "type": "number" },
              "lineHeight": { "type": "number" },
              "weight": { "type": "number" }
            }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["source", "step", "scale"],
      "properties": {
        "source": { "type": "string" },
        "step": { "type": "number" },
        "scale": { "type": "array", "minItems": 1, "items": { "type": "number" } }
      }
    },
    "radius": {
      "type": "object",
      "required": ["source", "values"],
      "properties": {
        "source": { "type": "string" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "elevation": {
      "type": "object",
      "required": ["source", "strategy"],
      "properties": {
        "source": { "type": "string" },
        "strategy": { "type": "string" },
        "levels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "iconography": {
      "type": "object",
      "required": ["source", "style", "sizes"],
      "properties": {
        "source": { "type": "string" },
        "style": { "type": "string" },
        "stroke": { "type": "number" },
        "sizes": { "type": "array", "minItems": 1, "items": { "type": "number" } }
      }
    }
  }
}
